# Placeholder template for NEW administrator .env; never use as authentication.
# database_setup reads .env against the postgres maintenance database.
# It creates ignored .env.owner (ifa_owner) and .env.app (ifa_app) when roles are new.
# Existing roles need their existing private files; no passwords are reset.
# Power BI uses .env.app privately, not this administrator template.
DB_HOST=<localhost>
DB_PORT=<5432>
DB_NAME=<postgres>
DB_USER=<local_administrator_role>
DB_PASSWORD=<private_administrator_password>
DB_SSLMODE=<prefer>
# Optional descriptive defaults; not all modules consume these variables.
DATA_RAW_DIR=<data/raw>
DATA_INTERIM_DIR=<data/interim>
DATA_PROCESSED_DIR=<data/processed>
HTTP_TIMEOUT_SECONDS=<30>
